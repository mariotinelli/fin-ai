  "decisions": [
    {
      "id": "q4",
      "statement": "Exigir tipo receita/despesa, valor positivo em reais, descrição, categoria e data da movimentação.",
      "decided_by": "Usuário — “q4. concordo”",
      "decided_at": "2026-11-04T19:14:16.778190+00:00",
      "status": "valid"
    },
    {
      "id": "q5",
      "statement": "Permitir receitas e despesas com data futura. Momento de inclusão no saldo e totais ainda não definido.",
      "decided_by": "Usuário — “q5. futuras também acho viavel”",
      "decided_at": "2026-11-04T19:14:16.778190+00:00",
      "status": "valid"
    },
    {
      "id": "q6",
      "statement": "Movimentações futuras passam a afetar saldo e totais automaticamente na data informada, permanecendo fora desses valores até então. Não há confirmação manual de pagamento ou recebimento.",
      "decided_by": "Usuário — “concordo” com a recomendação A apresentada em Q6",
      "decided_at": "2026-11-04T19:22:59.200382+00:00",
      "status": "valid"
    },
    {
      "id": "q7",
      "statement": "Categorias predefinidas por tipo: receitas — Salário, Freelance, Rendimentos, Outras receitas; despesas — Alimentação, Moradia, Transporte, Saúde, Educação, Lazer, Compras, Outras despesas.",
      "decided_by": "Usuário — “concordo” em resposta a Q7 e Q8",
      "decided_at": "2026-11-04T19:24:20.445320+00:00",
      "status": "valid"
    },
    {
      "id": "q8",
      "statement": "Histórico por mês ou todo o histórico, busca por descrição e filtros por tipo e categoria. Futuras aparecem identificadas como agendadas e podem ser localizadas e corrigidas antes da data.",
      "decided_by": "Usuário — “concordo” em resposta a Q7 e Q8",
      "decided_at": "2026-11-04T19:24:20.445320+00:00",
      "status": "valid"
    },
    {
      "id": "q9",
      "statement": "Usar America/Sao_Paulo para hoje e virada da data das movimentações.",
      "decided_by": "Usuário — “concordo” em resposta a Q9 e Q10",
      "decided_at": "2026-11-04T19:27:17.868552+00:00",
      "status": "valid"
    },
    {
      "id": "q10",
      "statement": "Permitir editar todos os campos de registros próprios passados ou futuros; excluir após confirmação, sem desfazer. Recalcular efeitos imediatamente, inclusive ao mover uma data passada para futura.",
      "decided_by": "Usuário — “concordo” em resposta a Q9 e Q10",
      "decided_at": "2026-11-04T19:27:17.868552+00:00",
      "status": "valid"
    }
  ],
